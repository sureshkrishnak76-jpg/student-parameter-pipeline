pipeline {
    agent any
    
    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
    }
    
    stages {
        stage('Workspace Extraction') {
            steps {
                echo '[JENKINS-PIPELINE] Initializing data sync from secure remote SCM distribution hosts...'
                git branch: 'main', url: 'https://github.com/sureshkrishnak76-jpg/student-parameter-pipeline.git'
            }
        }
        
        stage('Component Compilation') {
            steps {
                echo '[JENKINS-PIPELINE] Validating Python architectural files syntax integrity metrics...'
                bat 'python -m compileall .'
            }
        }
        
        stage('Execute Analytics Engine') {
            steps {
                echo '[JENKINS-PIPELINE] Booting calculations driver layer scripts...'
                bat 'python app.py'
            }
        }
        
        stage('Archive Output Artifacts') {
            steps {
                echo '[JENKINS-PIPELINE] Cataloging generated university tracking metric sheets inside storage lockers...'
                archiveArtifacts artifacts: 'student_report.txt', fingerprint: true
            }
        }
    }
}
